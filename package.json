{
  "name": "tong-ledger-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "benchmark:models": "node scripts/benchmark-models.mjs",
